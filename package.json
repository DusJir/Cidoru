{
  "name": "cidoru",
  "productName": "CIdoru",
  "version": "1.9.1",
  "description": "Alternative companion application for the IDORU P-1 multi-track player",
  "author": "Barney Estrada <barney.estrada@bastardizer.cz>",
  "homepage": "https://dev.grinware.cz",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=20.18.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "dev:electron": "electron-vite dev",
    "build:electron": "electron-vite build",
    "build:win": "electron-vite build && electron-builder --win",
    "build:linux": "electron-vite build && electron-builder --linux",
    "build:all": "electron-vite build && electron-builder --win --linux",
    "package:win": "electron-vite build && electron-builder --win --publish always",
    "package:linux": "electron-vite build && electron-builder --linux --publish always"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.5.0",
    "electron": "^39.0.0",
    "electron-builder": "^26.9.0",
    "electron-vite": "^5.0.0",
    "vite": "^6.4.2"
  },
  "build": {
    "appId": "com.cidoru.app",
    "productName": "CIdoru",
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "files": [
      "out/**"
    ],
    "extraResources": [
      {
        "from": "public",
        "to": "public",
        "filter": [
          "MANUAL.html"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "CIdoru-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CIdoru",
      "license": "LICENSE"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "CIdoru-Setup-${version}.AppImage",
      "category": "Audio"
    },
    "publish": {
      "provider": "github",
      "owner": "DusJir",
      "repo": "Cidoru"
    }
  },
  "overrides": {
    "glob": "^13.0.0",
    "rimraf": "^5.0.0",
    "tar": "^7.0.0",
    "@electron/asar": "^3.4.0",
    "esbuild": "^0.28.1"
  }
}